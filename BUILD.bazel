# Export the alias for compatibility
alias(
    name = "slang_slang",
    actual = ":slang",
)

# External headers filegroup
filegroup(
    name = "external_files",
    srcs = [
        "external/BS_thread_pool.hpp",
        "external/boost_concurrent.hpp",
        "external/boost_unordered.hpp",
        "external/expected.hpp",
        "external/ieee1800/sv_vpi_user.h",
        "external/ieee1800/svdpi.h",
        "external/ieee1800/vpi_compatibility.h",
        "external/ieee1800/vpi_user.h",
    ],
)

# External headers library
cc_library(
    name = "external_headers",
    hdrs = glob(["external/**/*.hpp", "external/**/*.h"], exclude_directories = 1),
    includes = ["external"],
    strip_include_prefix = "external",
)

# Test program to debug includes
cc_binary(
    name = "test_include",
    srcs = ["test_include.cpp"],
    deps = [":external_headers"],
)